---
import GameCardLink from '../components/GameCardLink.astro';
import SeasonSummary from '../components/SeasonSummary.astro';
import PicksTable from '../components/PicksTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteDescription, siteName } from '../data/site';
import { currentWeekGames, getAllGames, picksForGame } from '../lib/games';
import { currentWeekPicks, picks, summary } from '../lib/picks';
import { formatPublishedAt, getPublishedWeeks } from '../lib/posts';

const posts = await getPublishedWeeks();
const latest = posts[0];
const thisWeek = currentWeekPicks(picks);
const thisWeekCards = currentWeekGames(await getAllGames());
---

<BaseLayout title={siteName} description={siteDescription}>
  <h1>{siteName}</h1>
  <p class="lede">{siteDescription}</p>

  {summary ? <SeasonSummary summary={summary} /> : null}

  {
    thisWeekCards.length > 0 && (
      <section data-week-cards>
        <h2>This week's cards</h2>
        <ul class="card-list">
          {thisWeekCards.map((card) => {
            const badges = picksForGame(card.game_id, picks);
            return (
              <li data-game-id={card.game_id}>
                <GameCardLink gameId={card.game_id} away={card.away} home={card.home} />
                {badges.map((row) => (
                  <a class="pick-badge" href={`/picks/#pick-${row.pick_id}`}>
                    Pick
                  </a>
                ))}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    thisWeek.length === 0 ? (
      <p>No picks yet this season.</p>
    ) : (
      <section>
        <h2>This week</h2>
        <PicksTable picks={thisWeek} />
      </section>
    )
  }

  <section>
    <h2>Latest</h2>
    {
      latest ? (
        <article>
          <h3>
            <a href={`/weeks/${latest.id}/`}>{latest.data.title}</a>
          </h3>
          <p class="meta">
            <time datetime={latest.data.published_at}>{formatPublishedAt(latest.data.published_at)}</time>
          </p>
          <p class="summary">{latest.data.summary}</p>
        </article>
      ) : (
        <p>No published week yet.</p>
      )
    }
  </section>

  <section>
    <h2>Weeks</h2>
    {
      posts.length === 0 ? (
        <p>No published weeks yet.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/weeks/${post.id}/`}>{post.data.title}</a>
              <p class="summary">{post.data.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
