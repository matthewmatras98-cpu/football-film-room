---
import ProgramCard from '../components/ProgramCard.astro';
import SeasonSummary from '../components/SeasonSummary.astro';
import PicksTable from '../components/PicksTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteDescription, siteName } from '../data/site';
import { buildTime } from '../lib/current-week';
import { currentWeekGames, getAllGames, picksForGame, sortGameCards } from '../lib/games';
import { formatSeasonLine, homeEmptyNote } from '../lib/home';
import { currentWeekPicks, picks, summary } from '../lib/picks';
import { formatPublishedAt, getPublishedWeeks } from '../lib/posts';

const posts = await getPublishedWeeks();
const games = await getAllGames();
const gameIds = new Set(games.map((game) => game.game_id));
const now = buildTime();
const thisWeekCards = sortGameCards(currentWeekGames(games, undefined, now));
const thisWeek = currentWeekPicks(picks, now, games.length > 0 ? games : undefined);
const currentCard = thisWeekCards[0];
const emptyNote = homeEmptyNote(picks.length, posts.length, thisWeekCards.length);
---

<BaseLayout title={siteName} description={siteDescription} wide>
  <div class:list={['home-stack', { 'home-stack--cards': thisWeekCards.length > 0 }]}>
    <div class:list={['home-intro', { 'home-intro--summary': Boolean(summary) }]}>
      {summary ? <p class="kicker">Season performance</p> : null}
      <h1 class:list={[summary && 'visually-hidden']}>{summary ? 'Season record' : siteName}</h1>
      <p class="lede">
        {
          summary
            ? 'A public pick record graded against the closing line, kept in units.'
            : siteDescription
        }
      </p>
      {summary ? <SeasonSummary summary={summary} /> : null}
    </div>

    {emptyNote && thisWeekCards.length === 0 ? <p class="home-empty">{emptyNote}</p> : null}

    <div class="week-layout">
      <div class="home-column">
        {
          thisWeek.length > 0 ? (
            <div class="home-picks">
              <section class="section">
                <div class="section-head">
                  <h2>This week</h2>
                </div>
                <PicksTable picks={thisWeek} gameIds={gameIds} />
              </section>
            </div>
          ) : null
        }

        {
          thisWeekCards.length > 0 && (
            <section class="home-cards" data-week-cards>
              <div class="section-head">
                <div>
                  {currentCard ? (
                    <p class="kicker">
                      Season {currentCard.season}, week {currentCard.week}
                    </p>
                  ) : null}
                  <h2>This week's cards</h2>
                </div>
                <a class="section-link" href="/games/">View the full slate</a>
              </div>
              {emptyNote ? <p class="home-empty">{emptyNote}</p> : null}
              <ul class="card-list">
                {thisWeekCards.map((card) => (
                  <li class="game-card" data-game-id={card.game_id}>
                    <ProgramCard card={card} picks={picksForGame(card.game_id, picks)} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          summary && thisWeekCards.length > 0 ? (
            <p class="home-record-line nums">{formatSeasonLine(summary)}</p>
          ) : null
        }
        {thisWeek.length === 0 ? <p class="home-picks">No picks yet this season.</p> : null}
      </div>

      <aside class="rail" data-dispatches aria-labelledby="latest-notes">
        <p class="kicker">Latest notes</p>
        <h2 class="h2" id="latest-notes">Dispatches</h2>
        {
          posts.length === 0 ? (
            <ul class="note-list">
              <li>
                <p>No published weeks yet.</p>
              </li>
            </ul>
          ) : (
            <ul class="note-list">
              {posts.map((post) => (
                <li>
                  <p class="meta">
                    <time datetime={post.data.published_at}>{formatPublishedAt(post.data.published_at)}</time>
                  </p>
                  <h3>
                    <a href={`/weeks/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p>{post.data.summary}</p>
                </li>
              ))}
            </ul>
          )
        }
        <div class="callout">
          <p class="kicker">From the methodology</p>
          <blockquote>
            <p>Each pick is a flat 1 unit. Results are in units, never dollars.</p>
          </blockquote>
          <a class="btn" href="/methodology/">Read the methodology</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
