---
import PickCards from '../components/PickCards.astro';
import SeasonSummary from '../components/SeasonSummary.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllGames } from '../lib/games';
import { byWeek, picks, summary } from '../lib/picks';
import { getWriteups } from '../lib/writeups';

const weeks = byWeek(picks);
const games = await getAllGames();
const writeups = await getWriteups();
const severalSeasons = new Set(weeks.map((group) => group.season)).size > 1;
const gradingRules =
  'Each pick is a flat 1 unit. Grading assumes standard \u2212110 odds. A win is +0.909 units, a loss is \u22121.000 units, and a push is 0 units. Win percentage excludes pushes. CLV is shown for reference only and does not change the grade. Results are in units, never dollars.';
---

<BaseLayout
  title="Picks"
  description="Every published pick, graded against the closing line and kept in units."
  wide
>
  <p class="kicker">Public record</p>
  <h1>Official picks ledger</h1>
  <p class="lede">Every published pick, graded against the closing line and kept in units.</p>
  {summary ? <SeasonSummary summary={summary} variant="ledger" /> : null}
  {
    picks.length === 0 ? (
      <>
        <p>No picks yet this season.</p>
        <section>
          <h2>Grading rules</h2>
          <p>{gradingRules}</p>
          <p>
            <a href="/methodology/">Full methodology</a>
          </p>
        </section>
      </>
    ) : (
      <>
        <div class="filter-row">
          <a class="chip" href="#content" aria-current="true">
            All weeks
          </a>
          {weeks.map((group) => (
            <a class="chip" href={`#week-${group.season}-${group.week}`}>
              {severalSeasons ? `Season ${group.season}, week ${group.week}` : `Week ${group.week}`}
            </a>
          ))}
          <a class="chip" href="/methodology/">Grading rules</a>
        </div>
        <section>
          <h2>Grading rules</h2>
          <p>{gradingRules}</p>
        </section>
        {weeks.map((group) => (
          <section class="week-block" id={`week-${group.season}-${group.week}`}>
            <h2>
              Season {group.season}, week {group.week}
            </h2>
            <PickCards picks={group.picks} games={games} writeups={writeups} />
          </section>
        ))}
        <p>
          <a href="/methodology/">Methodology</a>
        </p>
      </>
    )
  }
</BaseLayout>
