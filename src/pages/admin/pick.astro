---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { activePicks } from '../../lib/admin/active-pick';
import { buildAdminData } from '../../lib/admin/admin-data';
import { voidsByWeek } from '../../lib/admin/voids';
import { getAllGames } from '../../lib/games';
import { picks } from '../../lib/picks';

const data = buildAdminData(await getAllGames(), picks);
const openPicks = activePicks(data.picks);
const voidWeeks = Object.entries(voidsByWeek(picks));
---

<BaseLayout noindex title="Enter a pick" description="Owner pick entry for the open week.">
  <p class="kicker">Owner</p>
  <h1>Enter a pick</h1>
  <p class="lede">One spread and one total per game. The server locks the pick 10 minutes before kickoff.</p>
  <p class="meta" id="signed-in"></p>
  <p>
    <a href="/auth/logout">Sign out</a>
  </p>

  <p id="games-loading">Loading open games.</p>
  <p id="games-empty" hidden>No open-week games are on the schedule.</p>
  <form id="pick-form" class="pick-form" action="/api/pick" method="post" hidden>
    <label>
      Game
      <select id="game_id" name="game_id" required></select>
    </label>
    <label>
      Market
      <select id="market" name="market">
        <option value="spread">spread</option>
        <option value="total">total</option>
      </select>
    </label>
    <label>
      Side
      <select id="side" name="side" required></select>
    </label>
    <label>
      Line
      <input id="line" name="line" inputmode="decimal" value="" />
    </label>
    <label>
      Confidence
      <select id="confidence" name="confidence">
        <option value="">—</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
      </select>
    </label>
    <label>
      Write-up
      <textarea id="writeup" name="writeup" maxlength="4000" rows="8"></textarea>
    </label>
    <p class="meta">
      <span id="writeup-count">0</span> / 4000
    </p>
    <button class="btn" type="submit">Submit pick</button>
  </form>

  <p id="pick-message" role="status"></p>
  <p id="pick-poll" class="meta"></p>

  <h2>Voided picks</h2>
  <p id="voids-empty" hidden={voidWeeks.length > 0}>No voided picks.</p>
  {
    voidWeeks.map(([week, rows]) => (
      <section>
        <h3>Week {week}</h3>
        <ul class="open-picks">
          {rows.map((row) => (
            <li data-void-game={row.game_id} data-void-market={row.pick.market} data-repick={row.repick?.pick_id ?? ''}>
              <p>
                {row.game_id} · {row.pick.side} · {row.pick.market} · {row.pick.line_at_pick}
              </p>
              <p class="meta">Picked {row.pick.picked_at}</p>
              <p class="meta">Voided {row.voided_at ?? '—'}</p>
              {row.repick ? (
                <p>
                  Re-pick {row.repick.pick_id} · {row.repick.side} · {row.repick.line_at_pick} · {row.repick.picked_at}
                </p>
              ) : (
                <p class="meta">No re-pick</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <h2>Your open picks</h2>
  <p id="open-empty" hidden={openPicks.length > 0}>No open picks.</p>
  <ul class="open-picks" id="open-picks" hidden={openPicks.length === 0}>
    {
      openPicks.map((pick) => (
        <li data-pick-id={pick.pick_id} data-kickoff={pick.kickoff_utc ?? ''}>
          <p>
            {pick.game_id} · {pick.side} · {pick.market}
          </p>
          <button class="btn" type="button" data-void={pick.pick_id} disabled>
            Void
          </button>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<script>
  import '../../scripts/admin-pick';
</script>
