---
import { STATUS_LABEL } from '../lib/picks';

interface Props {
  status: string;
}

const { status } = Astro.props;
const known = STATUS_LABEL[status as keyof typeof STATUS_LABEL];
const label = status === 'void' ? 'Void' : (known ?? status);
---

<span class:list={['status', `status-${status}`]}>{label}</span>
