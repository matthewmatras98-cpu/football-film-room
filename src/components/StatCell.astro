---
import { formatStatKind, statFootnote, type StatKind } from '../lib/format-stat';
import type { StatNumber } from '../lib/game-schema';

interface Props {
  stat: StatNumber;
  kind: StatKind;
  showSource?: boolean;
}

const { stat, kind, showSource = true } = Astro.props;
const text = formatStatKind(stat, kind);
---

<span class="stat" data-value={stat.value === null ? 'null' : String(stat.value)} data-source={stat.source}>
  <span class="stat-value">{text}</span>
  {showSource ? <span class="stat-meta">{statFootnote(stat)}</span> : null}
</span>
