---
import WriteupAccordion from './WriteupAccordion.astro';
import { formatCardPick, officialCardPicks } from '../lib/card-pick';
import { formatEpaStory } from '../lib/format-stat';
import { formatMst } from '../lib/picks';
import { slateLine } from '../lib/program';
import type { GameCard } from '../lib/game-schema';
import type { PickView } from '../lib/picks-schema';
import { writeupForPick, type Writeup as WriteupEntry } from '../lib/writeup';

interface Props {
  card: GameCard;
  picks: PickView[];
  level?: 'h2' | 'h3';
  writeups?: readonly WriteupEntry[];
}

const { card, picks, level = 'h3', writeups: providedWriteups } = Astro.props;
const Title = level;
const prompt = card.sections.story_prompts[0];
const official = officialCardPicks(picks);
const writeups =
  providedWriteups ?? (official.length > 0 ? await (await import('../lib/writeups')).getWriteups() : []);
const matchup = `${card.away} at ${card.home}`;
---

<div class="game-card-meta">
  <span class="when">
    <time datetime={card.kickoff_utc}>{formatMst(card.kickoff_utc)}</time>
  </span>
  <span class="line nums">{slateLine(card.line_latest, card.home)}</span>
</div>
<Title class="game-title">
  <a class="game-card-link" href={`/games/${card.game_id}/`}>{card.away} @ {card.home}</a>
</Title>
{prompt ? <p class="game-angle">{prompt.title}</p> : null}
{prompt ? <p class="game-story">{formatEpaStory(prompt.title, prompt.body)}</p> : null}
<div class="game-card-foot">
  <div class="program-pick">
    Program pick
    {
      official.length === 0 ? (
        <span class="badge badge--none">No official pick</span>
      ) : (
        official.map((row) => <span class="badge badge--none pick-line">{formatCardPick(row)}</span>)
      )
    }
  </div>
  <a class="section-link" href={`/games/${card.game_id}/`}>Read matchup notes</a>
</div>
{
  official.map((row) => {
    const entry = writeupForPick(row.pick_id, writeups);
    return entry ? <WriteupAccordion entry={entry} matchup={matchup} /> : null;
  })
}
